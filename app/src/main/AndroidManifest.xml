<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:name=".CloudApp" android:theme="@style/AppTheme" android:label="云幕 TV" android:icon="@drawable/app_icon"
        android:banner="@drawable/tv_banner" android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:enableOnBackInvokedCallback="false" android:supportsRtl="true"
        android:usesCleartextTraffic="true" android:hardwareAccelerated="true">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".CloudBrowserActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".CloudFilesActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".MovieWallActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".HistoryActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".PosterSettingsActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".SettingsActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".UpdateActivity" android:screenOrientation="landscape" android:exported="false" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
        <activity android:name=".PlayerActivity" android:screenOrientation="landscape" android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />
    </application>
</manifest>
